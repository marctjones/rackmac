#lang racket/base
;; Line icons drawn as vectors (Fluent System Icons style: one stroke weight on a 16-unit
;; grid, round caps), rendered into bitmaps at the display's backing scale so they are
;; crisp on Retina and 200% Windows displays. docs/UI-DESIGN.md section 1.5.
(require racket/class racket/draw racket/math racket/list)
(provide icon-bitmap letter-tile-bitmap icon-names icon-name?)

;; Each icon is a procedure (dc) -> void drawing in a 16 x 16 coordinate space with the pen
;; and brush already set. Helpers keep them short.
(define (line dc x1 y1 x2 y2) (send dc draw-line x1 y1 x2 y2))
(define (rect dc x y w h) (send dc draw-rectangle x y w h))
(define (rrect dc x y w h [r 1.5]) (send dc draw-rounded-rectangle x y w h r))
(define (circle dc cx cy r) (send dc draw-ellipse (- cx r) (- cy r) (* 2 r) (* 2 r)))
(define (poly dc pts) (send dc draw-lines (for/list ([p pts]) (cons (car p) (cadr p)))))
(define (fill-poly dc pts)
  (define old (send dc get-brush))
  (send dc set-brush (send (send dc get-pen) get-color) 'solid)
  (send dc draw-polygon (for/list ([p pts]) (cons (car p) (cadr p))))
  (send dc set-brush old))
(define (arc dc cx cy r from to) (send dc draw-arc (- cx r) (- cy r) (* 2 r) (* 2 r) from to))

(define (page dc) (poly dc '((3.5 1.5) (9.5 1.5) (12.5 4.5) (12.5 14.5) (3.5 14.5) (3.5 1.5))) (poly dc '((9.5 1.5) (9.5 4.5) (12.5 4.5))))
(define (magnifier dc) (circle dc 6.5 6.5 4.5) (line dc 10 10 14.5 14.5))
(define (arrow-curve dc left?)
  (if left?
      (begin (arc dc 8 9 5 (* pi 0.0) (* pi 0.95)) (poly dc '((1.5 5.5) (3 9) (6.5 7.5))))
      (begin (arc dc 8 9 5 (* pi 0.05) (* pi 1.0)) (poly dc '((14.5 5.5) (13 9) (9.5 7.5))))))
(define (lines dc ys [x1 2.5] [x2 13.5]) (for ([y ys]) (line dc x1 y x2 y)))

(define icons
  (hash
   "new"        (lambda (dc) (page dc) (line dc 8 7 8 12) (line dc 5.5 9.5 10.5 9.5))
   "open"       (lambda (dc) (poly dc '((1.5 13.5) (1.5 3.5) (6 3.5) (7.5 5) (13.5 5) (13.5 7)))
                             (poly dc '((1.5 13.5) (4 7.5) (15 7.5) (12.5 13.5) (1.5 13.5))))
   "save"       (lambda (dc) (poly dc '((2.5 2.5) (11.5 2.5) (13.5 4.5) (13.5 13.5) (2.5 13.5) (2.5 2.5)))
                             (rect dc 5 2.5 5 3.5) (rect dc 4.5 9 7 4.5))
   "save-as"    (lambda (dc) (poly dc '((2.5 2.5) (11.5 2.5) (13.5 4.5) (13.5 7))) (poly dc '((2.5 2.5) (2.5 13.5) (7 13.5)))
                             (rect dc 5 2.5 5 3.5) (line dc 9 14 14 9) (line dc 12.5 7.5 15 10))
   "close"      (lambda (dc) (line dc 4 4 12 12) (line dc 12 4 4 12))
   "x"          (lambda (dc) (line dc 4 4 12 12) (line dc 12 4 4 12))
   "undo"       (lambda (dc) (arrow-curve dc #t))
   "redo"       (lambda (dc) (arrow-curve dc #f))
   "cut"        (lambda (dc) (circle dc 4.5 12 2.25) (circle dc 11.5 12 2.25) (line dc 5.8 10.2 11.5 1.5) (line dc 10.2 10.2 4.5 1.5))
   "copy"       (lambda (dc) (rrect dc 5.5 5.5 8.5 9) (poly dc '((3.5 11.5) (2 11.5) (2 2) (10 2) (10 3.5))))
   "paste"      (lambda (dc) (rrect dc 2.5 3 11 11.5) (rrect dc 5.5 1.5 5 3 1) (lines dc '(8.5 11) 5 11))
   "find"       (lambda (dc) (magnifier dc))
   "search"     (lambda (dc) (magnifier dc))
   "replace"    (lambda (dc) (poly dc '((2 6) (2 3) (11 3))) (poly dc '((9 1) (11 3) (9 5)))
                             (poly dc '((14 10) (14 13) (5 13))) (poly dc '((7 11) (5 13) (7 15))))
   "run"        (lambda (dc) (fill-poly dc '((4.5 2.5) (13 8) (4.5 13.5))))
   "run-all"    (lambda (dc) (fill-poly dc '((2 3) (8 8) (2 13))) (fill-poly dc '((8 3) (14 8) (8 13))))
   "palette"    (lambda (dc) (rrect dc 1.5 2.5 13 11) (poly dc '((4 6) (6.5 8) (4 10))) (line dc 8 10.5 11.5 10.5))
   "goto"       (lambda (dc) (lines dc '(3 13)) (line dc 2 8 10 8) (poly dc '((7.5 5.5) (10 8) (7.5 10.5))) (line dc 13.5 5.5 13.5 10.5))
   "comment"    (lambda (dc) (line dc 5 13 8.5 3) (line dc 8.5 13 12 3))
   "duplicate"  (lambda (dc) (rrect dc 2 2 9 5) (rrect dc 5 9 9 5))
   "delete-line" (lambda (dc) (lines dc '(4 12)) (line dc 5 6 11 10) (line dc 11 6 5 10))
   "indent"     (lambda (dc) (lines dc '(2.5 13.5)) (lines dc '(6.5 9.5) 7 13.5) (poly dc '((2 5.5) (4.5 8) (2 10.5))))
   "outdent"    (lambda (dc) (lines dc '(2.5 13.5)) (lines dc '(6.5 9.5) 7 13.5) (poly dc '((4.5 5.5) (2 8) (4.5 10.5))))
   "arrow-up"   (lambda (dc) (line dc 8 13.5 8 2.5) (poly dc '((3.5 7) (8 2.5) (12.5 7))))
   "arrow-down" (lambda (dc) (line dc 8 2.5 8 13.5) (poly dc '((3.5 9) (8 13.5) (12.5 9))))
   "chevron-left"  (lambda (dc) (poly dc '((10 3) (5 8) (10 13))))
   "chevron-right" (lambda (dc) (poly dc '((6 3) (11 8) (6 13))))
   "chevron-down"  (lambda (dc) (poly dc '((3 6) (8 11) (13 6))))
   "select-all" (lambda (dc) (for ([x '(2 6 10)]) (line dc x 2 (+ x 2) 2) (line dc x 14 (+ x 2) 14))
                             (for ([y '(2 6 10)]) (line dc 2 y 2 (+ y 2)) (line dc 14 y 14 (+ y 2))) (lines dc '(6.5 9.5) 5.5 10.5))
   "settings"   (lambda (dc) (circle dc 8 8 2.5)
                             (for ([k 8]) (define a (* k (/ pi 4)))
                               (line dc (+ 8 (* 4.5 (cos a))) (+ 8 (* 4.5 (sin a))) (+ 8 (* 6.5 (cos a))) (+ 8 (* 6.5 (sin a)))))
                             (circle dc 8 8 4.5))
   "extensions" (lambda (dc) (rrect dc 2 2 5 5) (rrect dc 9 2 5 5) (rrect dc 2 9 5 5) (rrect dc 9 9 5 5))
   "history"    (lambda (dc) (arc dc 8 8 6 (* pi -1.25) (* pi 0.9)) (poly dc '((1 4.5) (2.2 7.2) (4.8 6))) (poly dc '((8 4.5) (8 8) (10.5 9.5))))
   "info"       (lambda (dc) (circle dc 8 8 6.5) (line dc 8 7 8 11.5) (line dc 8 4.5 8 4.6))
   "help"       (lambda (dc) (circle dc 8 8 6.5) (arc dc 8 6.3 2.2 (* pi -0.5) (* pi 1.0)) (line dc 8 8.5 8 9.5) (line dc 8 11.5 8 11.6))
   "keyboard"   (lambda (dc) (rrect dc 1 4 14 9) (for* ([x '(4 7 10 12.5)] [y '(7 9.5)]) (line dc x y (+ x 0.1) y)) (line dc 5 11 11 11))
   "book"       (lambda (dc) (poly dc '((8 4) (8 14))) (poly dc '((8 4) (6 2.5) (1.5 2.5) (1.5 12.5) (6 12.5) (8 14)))
                             (poly dc '((8 4) (10 2.5) (14.5 2.5) (14.5 12.5) (10 12.5) (8 14))))
   "language"   (lambda (dc) (poly dc '((5 4) (1.5 8) (5 12))) (poly dc '((11 4) (14.5 8) (11 12))) (line dc 9.5 3 6.5 13))
   "activity"   (lambda (dc) (for ([y '(4 8 12)]) (line dc 2 y 2.1 y) (line dc 5 y 14 y)))
   "theme"      (lambda (dc) (circle dc 8 8 6) (arc dc 8 8 6 (* pi 0.5) (* pi 1.5))
                             (fill-poly dc (for/list ([k 13]) (define a (+ (* pi 0.5) (* k (/ pi 12)))) (list (+ 8 (* 6 (cos a))) (- 8 (* 6 (sin a))))))) 
   "wrap"       (lambda (dc) (line dc 2 3.5 14 3.5) (poly dc '((2 8) (12 8))) (arc dc 12 10.25 2.25 (* pi -0.5) (* pi 0.5))
                             (line dc 12 12.5 8 12.5) (poly dc '((9.5 11) (8 12.5) (9.5 14))) (line dc 2 12.5 5 12.5))
   "zoom-in"    (lambda (dc) (magnifier dc) (line dc 4.5 6.5 8.5 6.5) (line dc 6.5 4.5 6.5 8.5))
   "zoom-out"   (lambda (dc) (magnifier dc) (line dc 4.5 6.5 8.5 6.5))
   "zoom-reset" (lambda (dc) (magnifier dc) (line dc 6.5 4.5 6.5 8.5) (line dc 5.5 5.2 6.5 4.5))
   "maximize"   (lambda (dc) (poly dc '((2 6) (2 2) (6 2))) (poly dc '((10 2) (14 2) (14 6)))
                             (poly dc '((14 10) (14 14) (10 14))) (poly dc '((6 14) (2 14) (2 10))))
   "print"      (lambda (dc) (rect dc 4.5 1.5 7 4) (rrect dc 1.5 5.5 13 6) (rect dc 4.5 9.5 7 5) (lines dc '(12) 6 10))
   "more"       (lambda (dc) (for ([x '(3 8 13)]) (circle dc x 8 0.6)))
   "check"      (lambda (dc) (poly dc '((2.5 8.5) (6 12) (13.5 4))))
   "warning"    (lambda (dc) (poly dc '((8 1.5) (15 14) (1 14) (8 1.5))) (line dc 8 6 8 9.5) (line dc 8 11.8 8 11.9))
   "error"      (lambda (dc) (circle dc 8 8 6.5) (line dc 5.5 5.5 10.5 10.5) (line dc 10.5 5.5 5.5 10.5))))

(define (icon-names) (sort (hash-keys icons) string<?))
(define (icon-name? s) (hash-has-key? icons s))

(define cache (make-hash))

(define (render size scale color draw)
  (define bm (make-bitmap size size #t #:backing-scale scale))
  (define dc (new bitmap-dc% [bitmap bm]))
  (send dc set-smoothing 'smoothed)
  (send dc set-scale (/ size 16) (/ size 16))
  (send dc set-pen (new pen% [color color] [width (if (<= size 16) 1.25 1.5)] [cap 'round] [join 'round]))
  (send dc set-brush "white" 'transparent)
  (draw dc)
  (send dc set-bitmap #f)
  bm)

(define (color-key c) (list (send c red) (send c green) (send c blue)))

;; A bitmap for icon `name` at `size` logical pixels. Unknown names raise, so a typo in
;; #:icon is caught by the tests rather than showing an empty button.
(define (icon-bitmap name #:size [size 16] #:color [color (make-object color% 40 40 40)] #:scale [scale 1.0])
  (define draw (hash-ref icons name (lambda () (raise-argument-error 'icon-bitmap "a known icon name" name))))
  (hash-ref! cache (list name size (color-key color) scale) (lambda () (render size scale color draw))))

;; For commands without an icon: their initial in a rounded square (needed by "Add to Toolbar").
(define (letter-tile-bitmap letter #:size [size 16] #:color [color (make-object color% 40 40 40)] #:scale [scale 1.0])
  (hash-ref! cache (list 'tile letter size (color-key color) scale)
             (lambda ()
               (render size scale color
                       (lambda (dc)
                         (rrect dc 1 1 14 14 3)
                         (send dc set-font (make-font #:size 9 #:weight 'bold #:size-in-pixels? #t))
                         (send dc set-text-foreground color)
                         (define-values (w h d a) (send dc get-text-extent letter))
                         (send dc draw-text letter (/ (- 16 w) 2) (/ (- 16 h) 2)))))))
